{
  "rules": [
    {
      "allowed": {
        "origins": ["https://YOUR-DOMAIN.com", "https://YOUR-PROJECT.vercel.app", "http://localhost:3000"],
        "methods": ["PUT", "GET", "HEAD"],
        "headers": ["content-type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
