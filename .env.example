# Copy to .env (gitignored) and fill in only what you use. Never commit real values.
# ./run_ui.sh loads .env automatically. For the CLI: set -a; . ./.env; set +a

# fetch_jobs.py: Jooble search API (free tier, per-country key)
JOOBLE_API_KEY=

# fetch_jobs.py: Apify token for the Jobright source (billable; needs --allow-apify-spend)
APIFY_TOKEN=

# Neon Postgres. The hosted app (Vercel) needs it; server.py shares the same accounts when
# it is set here, or uses .studio/vouch.db when empty. Use the pooled connection string.
DATABASE_URL=

# server.py: comma-separated emails that become admins on sign-up (else .studio/admins.txt)
VOUCH_ADMIN_EMAILS=

# Cloudflare R2: profiles, Pro build PDFs, review images/PDFs/videos and the job index.
# Set all four or none. Create an API token with Object Read & Write on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: a jurisdiction-specific endpoint, e.g. https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=

# Shared secret between the Next.js API routes and the Python engine function (api/engine.py).
# Generate one: openssl rand -hex 32
ENGINE_SECRET=
# Local dev only: where `npm run engine` listens. On Vercel leave it unset (same deployment).
ENGINE_URL=http://127.0.0.1:8787/api/engine

# Vercel cron (/api/cron/cleanup) sends this as a bearer token. openssl rand -hex 32
CRON_SECRET=
