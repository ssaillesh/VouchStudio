# Copy to .env (gitignored) and fill in only what you use. Never commit real values.
# ./run_ui.sh loads .env automatically. For the CLI: set -a; . ./.env; set +a

# fetch_jobs.py: Jooble search API (free tier, per-country key)
JOOBLE_API_KEY=

# fetch_jobs.py: Apify token for the Jobright source (billable; needs --allow-apify-spend)
APIFY_TOKEN=

# server.py: Postgres (for example Neon) for accounts; empty uses .studio/vouch.db
DATABASE_URL=

# server.py: comma-separated emails that become admins on sign-up (else .studio/admins.txt)
VOUCH_ADMIN_EMAILS=
